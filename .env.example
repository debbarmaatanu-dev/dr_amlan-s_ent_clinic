# Frontend (Vite) environment variables
# Copy to `.env.local` for local development (do NOT commit `.env.local`).
#
# Notes:
# - Only variables prefixed with `VITE_` are exposed to the browser bundle.
# - Never put PhonePe secrets, Firebase Admin credentials, or webhook passwords here.

# Backend base URL (separate Vercel project)
# Example: https://your-backend.vercel.app
VITE_API_BACKEND_URL=

# Firebase Web App config (public keys, safe to be in VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional (only if Analytics is enabled in the frontend)
VITE_FIREBASE_MEASUREMENT_ID=

# Admin allowlist (client-side UX only; backend still enforces authorization)
VITE_FIREBASE_ADMIN_EMAIL1=
VITE_FIREBASE_ADMIN_EMAIL2=

