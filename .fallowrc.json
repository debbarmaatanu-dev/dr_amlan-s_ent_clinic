{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/main.{js,jsx,ts,tsx}"],
  "ignorePatterns": [
    "**/*.test.{js,jsx,ts,tsx}",
    "**/*.spec.{js,jsx,ts,tsx}",
    "src/tests/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/dist/**",
    "**/build/**",
    "coverage/**",
    "jest.config.cjs",
    "jest.setup.cjs",
    "babel.jest.cjs",
    "scripts/**",
    "api/payment/webhook-test.js",
    "api/payment/webhook.js"
  ],
  "ignoreDependencies": [
    "@babel/core",
    "@babel/preset-env",
    "@babel/preset-react",
    "@babel/preset-typescript",
    "@lavamoat/allow-scripts",
    "@tailwindcss/vite",
    "@testing-library/dom",
    "@testing-library/jest-dom",
    "@testing-library/react",
    "@testing-library/user-event",
    "@types/jest",
    "@types/js-cookie",
    "@types/node",
    "@types/react",
    "@types/react-dom",
    "@vitejs/plugin-react",
    "babel-jest",
    "fallow",
    "immer",
    "jest",
    "jest-environment-jsdom",
    "oxc-transform-react",
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint",
    "tailwindcss",
    "typescript",
    "vite"
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/lib/**",
      "**/dist/**",
      "**/build/**",
      "**/node_modules/**",
      "**/docs/**",
      "coverage/**",
      "src/features/**/tests/**",
      "src/shared/**/tests/**",
      "src/tests/**",
      "**/tests/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "src/appStore/*"
    ],
    "mode": "mild"
  },
  "health": {
    "ignore": [
      "src/features/**/tests/**",
      "src/shared/**/tests/**",
      "src/tests/**",
      "**/tests/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.{js,jsx,ts,tsx}",
      "**/*.spec.{js,jsx,ts,tsx}",
      "scripts/**"
    ]
  },
  "rules": {
    "circular-dependencies": "error",
    "unused-types": "off",
    "unused-exports": "off"
  }
}
