{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSameLine": true,
  "bracketSpacing": false,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "printWidth": 80,
  "semi": true,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "node_modules",
    "build",
    "dist",
    "coverage",
    "index.html",
    "src/index.css",
    "public",
    "api"
  ]
}
