{
  "name": "dr_amlan-s_ent_clinic",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": {
    "name": "Atanu Debbarma",
    "url": "https://github.com/AtanuDebbarma"
  },
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/debbarmaatanu-dev/dr_amlan-s_ent_clinic"
  },
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx tsc -b && bun x vite build",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "bunx prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss}\"",
    "preview": "bunx vite preview",
    "tsc": "bunx tsc --noEmit",
    "allow-scripts": "allow-scripts auto"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.2.4",
    "eslint-plugin-node": "11.1.0",
    "firebase": "12.12.1",
    "html-to-image": "1.11.13",
    "immer": "11.1.4",
    "js-cookie": "3.0.5",
    "jspdf": "4.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "7.14.2",
    "react-spinners": "0.17.0",
    "tailwindcss": "4.2.4",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lavamoat/allow-scripts": "5.0.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "@typescript-eslint/parser": "8.59.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "6.1.1"
  },
  "trustedDependencies": [
    "vite",
    "@vitejs/plugin-react",
    "eslint",
    "tailwindcss",
    "esbuild",
    "unrs-resolver",
    "@firebase/util",
    "core-js",
    "protobufjs"
  ],
  "lavamoat": {
    "allowScripts": {
      "esbuild": true,
      "protobufjs": true,
      "core-js": true,
      "unrs-resolver": true,
      "$root$": false
    }
  }
}
